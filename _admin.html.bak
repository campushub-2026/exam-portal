<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Admin Portal - CampusHub</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://www.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <!-- PDF.js for parsing PDF files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <!-- Mammoth.js for parsing DOCX files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
    <link rel="stylesheet" href="style.css">
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: { extend: { colors: { "primary": "#135bec" }, fontFamily: { "display": ["Lexend", "sans-serif"] } } },
        }
    </script>
    <style>
        /* Custom tweaks for mobile height calculations */
        .h-safe-screen {
            height: calc(100vh - 73px);
        }

        @media (max-width: 768px) {
            .h-safe-screen {
                height: calc(100vh - 130px);
                /* Adjust for bottom nav */
            }
        }
    </style>
    <script>
        // Immediate Auth Check
        if (!localStorage.getItem('NSCH_ADMIN_BYPASS')) {
            window.location.href = 'index.html';
        }
    </script>
</head>

<body class="bg-slate-50 dark:bg-[#101622] text-slate-900 dark:text-white font-display overflow-x-hidden">
    <div class="min-h-screen flex flex-col" id="admin-portal">
        <!-- Navbar -->
        <nav
            class="bg-white dark:bg-[#1a2235] border-b border-slate-200 dark:border-slate-800 px-4 md:px-6 py-4 flex justify-between items-center sticky top-0 z-30">
            <div class="flex items-center gap-4 md:gap-6">
                <a href="index.html"
                    class="flex items-center gap-2 text-slate-500 hover:text-primary transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>

                <div class="flex items-center gap-2">
                    <img src="NSCH Logo (1).png" alt="Logo" class="w-8 h-8 object-contain">
                    <h1 class="text-lg md:text-xl font-bold text-slate-900 dark:text-white truncate">Safe Netizen <span
                            class="text-primary">Admin</span></h1>
                </div>

                <!-- Desktop Nav Links -->
                <div class="hidden md:flex gap-1 ml-6 bg-slate-100 dark:bg-slate-800 p-1 rounded-lg">
                    <button onclick="switchAdminTab('exams')" id="nav-exams"
                        class="px-4 py-1.5 rounded-md text-sm font-bold bg-white dark:bg-slate-700 shadow-sm transition-all text-primary">Exams</button>
                    <button onclick="switchAdminTab('students')" id="nav-students"
                        class="px-4 py-1.5 rounded-md text-sm font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-all">Students</button>
                    <button onclick="switchAdminTab('system')" id="nav-system"
                        class="px-4 py-1.5 rounded-md text-sm font-bold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-all">System</button>
                </div>
            </div>
            <div class="flex gap-4">
                <button onclick="document.getElementById('create-exam-modal').classList.remove('hidden')"
                    class="bg-primary text-white px-3 md:px-4 py-2 rounded-lg font-bold hover:bg-primary/90 transition-transform active:scale-95 flex items-center gap-2 shadow-lg shadow-primary/30 whitespace-nowrap">
                    <span class="material-symbols-outlined text-sm">add</span> <span class="hidden md:inline">New
                        Exam</span><span class="md:hidden">New</span>
                </button>
            </div>
        </nav>

        <!-- DASHBOARD VIEW -->
        <main id="admin-dashboard-container" class="flex-1 p-4 md:p-6 max-w-7xl mx-auto w-full pb-20 md:pb-6">

            <!-- EXAMS SECTION -->
            <div id="section-exams">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl md:text-2xl font-bold">Your Exams</h2>
                    <div id="connection-status" class="text-xs font-bold text-slate-400 flex items-center gap-1">
                        <div class="w-2 h-2 rounded-full bg-slate-400"></div> <span class="hidden md:inline">Checking
                            connection...</span><span class="md:hidden">Offline</span>
                    </div>
                </div>
                <div id="admin-exam-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                    <div class="col-span-full text-center py-20">
                        <p class="text-slate-400 animate-pulse font-bold">Loading Exams...</p>
                    </div>
                </div>
            </div>

            <!-- STUDENTS SECTION -->
            <div id="section-students" class="hidden">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold">Student Management</h2>
                        <p class="text-xs text-slate-500">View and manage enrolled students.</p>
                    </div>
                </div>
                <div
                    class="bg-white dark:bg-[#1a2235] rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead
                                class="bg-slate-50 dark:bg-slate-800 border-b border-slate-100 dark:border-slate-700">
                                <tr>
                                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Student</th>
                                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Exams Taken</th>
                                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Avg. Score</th>
                                    <th class="p-4 text-xs font-bold uppercase text-slate-500 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="student-list-body" class="divide-y divide-slate-100 dark:divide-slate-800">
                                <tr>
                                    <td colspan="4" class="p-8 text-center text-slate-400">Loading students...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- SYSTEM STATUS SECTION -->
            <div id="section-system" class="hidden">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold">System Status</h2>
                        <p class="text-xs text-slate-500">Production control room — real-time health monitoring.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span id="system-last-check" class="text-[10px] text-slate-400 font-bold hidden md:inline">Last check: —</span>
                        <button onclick="runSystemChecks()" class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 px-4 py-2 rounded-lg font-bold text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-sm" id="system-refresh-icon">refresh</span> Refresh
                        </button>
                    </div>
                </div>

                <!-- Overall Health -->
                <div id="system-health-banner" class="mb-6 p-6 rounded-xl border-2 flex items-center gap-4 bg-white dark:bg-[#1a2235] border-slate-200 dark:border-slate-800">
                    <div id="system-health-dot" class="w-5 h-5 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    <div>
                        <h3 id="system-health-title" class="font-bold text-lg">Checking Systems...</h3>
                        <p id="system-health-subtitle" class="text-xs text-slate-500">Running diagnostics</p>
                    </div>
                </div>

                <!-- Infrastructure Checks -->
                <h3 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Infrastructure</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
                    <div id="check-firebase-auth" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">shield_person</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">Firebase Auth</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                    <div id="check-firestore" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">database</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">Firestore DB</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                    <div id="check-website" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">language</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">Website</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                    <div id="check-cdn" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">cloud_done</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">CDN Services</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                    <div id="check-storage" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">hard_drive</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">Local Storage</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                    <div id="check-latency" class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-slate-400">speed</span></div>
                        <div class="flex-1 min-w-0"><p class="text-xs font-bold uppercase text-slate-400">DB Latency</p><p class="text-sm font-bold text-slate-600 dark:text-slate-300 truncate">Checking...</p></div>
                        <div class="w-3 h-3 rounded-full bg-slate-300 animate-pulse shrink-0"></div>
                    </div>
                </div>

                <!-- Platform Metrics -->
                <h3 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Platform Metrics</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                        <p class="text-xs font-bold uppercase text-slate-400 mb-1">Total Exams</p>
                        <p id="metric-exams" class="text-3xl font-black text-slate-800 dark:text-white">—</p>
                    </div>
                    <div class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                        <p class="text-xs font-bold uppercase text-slate-400 mb-1">Total Questions</p>
                        <p id="metric-questions" class="text-3xl font-black text-slate-800 dark:text-white">—</p>
                    </div>
                    <div class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                        <p class="text-xs font-bold uppercase text-slate-400 mb-1">Active Students</p>
                        <p id="metric-students" class="text-3xl font-black text-slate-800 dark:text-white">—</p>
                    </div>
                    <div class="bg-white dark:bg-[#1a2235] p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                        <p class="text-xs font-bold uppercase text-slate-400 mb-1">Last Activity</p>
                        <p id="metric-last-activity" class="text-sm font-bold text-slate-800 dark:text-white mt-1">—</p>
                    </div>
                </div>
            </div>

        </main>

        <!-- Mobile Bottom Nav -->
        <div
            class="md:hidden fixed bottom-0 left-0 right-0 bg-white dark:bg-[#1a2235] border-t border-slate-200 dark:border-slate-800 flex z-40 pb-safe">
            <button onclick="switchAdminTab('exams')" id="mobile-nav-exams"
                class="flex-1 py-3 text-xs font-bold text-primary flex flex-col items-center gap-1 transition-colors border-t-2 border-primary">
                <span class="material-symbols-outlined">description</span>
                Exams
            </button>
            <button onclick="switchAdminTab('students')" id="mobile-nav-students"
                class="flex-1 py-3 text-xs font-bold text-slate-500 flex flex-col items-center gap-1 transition-colors border-t-2 border-transparent">
                <span class="material-symbols-outlined">group</span>
                Students
            </button>
            <button onclick="switchAdminTab('system')" id="mobile-nav-system"
                class="flex-1 py-3 text-xs font-bold text-slate-500 flex flex-col items-center gap-1 transition-colors border-t-2 border-transparent">
                <span class="material-symbols-outlined">monitor_heart</span>
                System
            </button>
        </div>

        <!-- QUESTION EDITOR VIEW (Hidden by default) -->
        <section id="question-editor-section"
            class="hidden fixed inset-0 z-50 bg-slate-50 dark:bg-[#101622] flex flex-col">
            <div
                class="bg-white dark:bg-[#1a2235] border-b border-slate-200 dark:border-slate-800 px-4 md:px-6 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <button onclick="window.closeQuestionEditor()"
                        class="text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center gap-1 font-bold text-sm bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg transition-colors">
                        <span class="material-symbols-outlined text-sm">arrow_back</span> <span
                            class="hidden md:inline">Back</span>
                    </button>
                    <div>
                        <h2 class="text-base md:text-lg font-bold truncate max-w-[200px] md:max-w-none"
                            id="editor-exam-title">Manage Questions</h2>
                        <p class="text-xs text-slate-500 hidden md:block">Add or edit questions for this exam</p>
                    </div>
                </div>
            </div>

            <div class="flex-1 flex flex-col md:flex-row overflow-hidden">
                <!-- Left: Question List -->
                <div
                    class="w-full md:w-1/3 h-48 md:h-full border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1a2235] flex flex-col shrink-0">
                    <div
                        class="p-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex justify-between items-center">
                        <h3 class="font-bold text-xs uppercase text-slate-500">Questions (<span id="q-count">0</span>)
                        </h3>
                        <div class="flex gap-4">
                            <button onclick="deleteAllQuestions()"
                                class="text-xs text-red-500 font-bold hover:underline">Delete All</button>
                            <button onclick="resetQuestionForm()"
                                class="text-xs text-primary font-bold hover:underline p-2">+
                                New</button>
                        </div>
                    </div>
                    <div id="questions-list" class="flex-1 overflow-y-auto p-4 flex flex-col gap-3">
                        <!-- Questions JS -->
                    </div>
                </div>

                <!-- Right: Form -->
                <div class="w-full md:w-2/3 flex-1 overflow-y-auto bg-slate-50 dark:bg-[#101622] p-4 md:p-8">
                    <div class="max-w-2xl mx-auto pb-20 md:pb-0">
                        <form id="add-question-form"
                            class="bg-white dark:bg-[#1a2235] p-6 md:p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800">
                            <!-- Hidden Select -->
                            <div class="hidden">
                                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Select Exam</label>
                                <select id="exam-select" required
                                    class="w-full rounded border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2"></select>
                            </div>

                            <div class="mb-6">
                                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Question
                                    Text</label>
                                <textarea id="q-text" required rows="3"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-3 focus:ring-primary focus:border-primary"
                                    placeholder="Enter question..."></textarea>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option
                                        A</label><input type="text" id="op-a" required
                                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                </div>
                                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option
                                        B</label><input type="text" id="op-b" required
                                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                </div>
                                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option
                                        C</label><input type="text" id="op-c" required
                                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                </div>
                                <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option
                                        D</label><input type="text" id="op-d" required
                                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                </div>
                            </div>

                            <div class="mb-6">
                                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Correct
                                    Option</label>
                                <select id="correct-op"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                    <option value="A">Option A</option>
                                    <option value="B">Option B</option>
                                    <option value="C">Option C</option>
                                    <option value="D">Option D</option>
                                </select>
                            </div>

                            <div class="flex gap-2 flex-col-reverse md:flex-row">
                                <button type="button" id="btn-cancel-edit" onclick="resetQuestionForm()"
                                    class="text-slate-500 px-4 py-3 md:py-2 font-bold hover:text-slate-800 hidden rounded-lg border border-transparent hover:border-slate-200 text-center">Cancel
                                    Edit</button>
                                <button type="submit" id="btn-save-question"
                                    class="bg-primary text-white px-6 py-3 md:py-2 rounded-lg font-bold hover:bg-primary/90 shadow-lg shadow-primary/20">Add
                                    Question</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <!-- IMPORT REVIEW OVERLAY -->
    <section id="import-review-section"
        class="hidden fixed inset-0 z-50 bg-slate-50 dark:bg-[#101622] flex flex-col">
        <div
            class="bg-white dark:bg-[#1a2235] border-b border-slate-200 dark:border-slate-800 px-4 md:px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <button onclick="cancelImportReview()"
                    class="text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center gap-1 font-bold text-sm bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-sm">close</span> <span
                        class="hidden md:inline">Cancel</span>
                </button>
                <div>
                    <h2 class="text-base md:text-lg font-bold" id="review-title">Review Imported Questions</h2>
                    <p class="text-xs text-slate-500"><span id="review-approved-count">0</span>/<span
                            id="review-total-count">0</span> approved</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="approveAllQuestions()"
                    class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-3 py-2 rounded-lg font-bold text-xs hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">done_all</span> <span class="hidden md:inline">Approve All</span>
                </button>
                <button id="btn-finalize-import" onclick="finalizeImport()" disabled
                    class="bg-primary text-white px-4 py-2 rounded-lg font-bold text-xs shadow-lg shadow-primary/30 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1 transition-all">
                    <span class="material-symbols-outlined text-sm">check_circle</span> Create Exam
                </button>
            </div>
        </div>

        <div class="flex-1 flex flex-col md:flex-row overflow-hidden">
            <!-- Left: Question List -->
            <div
                class="w-full md:w-1/3 h-48 md:h-full border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#1a2235] flex flex-col shrink-0">
                <div
                    class="p-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex justify-between items-center">
                    <h3 class="font-bold text-xs uppercase text-slate-500">Parsed Questions (<span
                            id="review-q-count">0</span>)</h3>
                </div>
                <div id="review-questions-list" class="flex-1 overflow-y-auto p-4 flex flex-col gap-2">
                </div>
            </div>

            <!-- Right: Edit Form -->
            <div class="w-full md:w-2/3 flex-1 overflow-y-auto bg-slate-50 dark:bg-[#101622] p-4 md:p-8">
                <div class="max-w-2xl mx-auto pb-20 md:pb-0">
                    <div id="review-empty-state" class="text-center py-20 text-slate-400">
                        <span class="material-symbols-outlined text-5xl mb-4 block">fact_check</span>
                        <p class="font-bold">Select a question from the list to review</p>
                    </div>
                    <form id="review-question-form"
                        class="hidden bg-white dark:bg-[#1a2235] p-6 md:p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800">
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-xs font-bold uppercase text-slate-400" id="review-q-label">Question
                                1</span>
                            <span id="review-q-status"
                                class="text-[10px] font-bold px-2 py-1 rounded-full bg-amber-100 text-amber-700">PENDING</span>
                        </div>
                        <div class="mb-6">
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Question Text</label>
                            <textarea id="review-q-text" rows="3"
                                class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-3 focus:ring-primary focus:border-primary"
                                placeholder="Question text..."></textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                            <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option A</label>
                                <input type="text" id="review-op-a"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                            </div>
                            <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option B</label>
                                <input type="text" id="review-op-b"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                            </div>
                            <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option C</label>
                                <input type="text" id="review-op-c"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                            </div>
                            <div><label class="block text-xs font-bold uppercase text-slate-500 mb-1">Option D</label>
                                <input type="text" id="review-op-d"
                                    class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                            </div>
                        </div>
                        <div class="mb-6">
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Correct Answer</label>
                            <select id="review-correct-op"
                                class="w-full rounded-lg border-slate-200 dark:bg-slate-800 dark:border-slate-700 p-2">
                                <option value="A">Option A</option>
                                <option value="B">Option B</option>
                                <option value="C">Option C</option>
                                <option value="D">Option D</option>
                            </select>
                        </div>
                        <div class="flex gap-2 flex-col-reverse md:flex-row">
                            <button type="button" onclick="deleteReviewQuestion()"
                                class="text-red-500 px-4 py-3 md:py-2 font-bold hover:text-red-700 rounded-lg border border-transparent hover:border-red-200 text-center text-sm">Remove
                                Question</button>
                            <button type="button" onclick="saveAndApproveQuestion()"
                                class="bg-primary text-white px-6 py-3 md:py-2 rounded-lg font-bold hover:bg-primary/90 shadow-lg shadow-primary/20 flex-1 flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-sm">check</span> Save & Approve
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Create Exam Modal -->
    <div id="create-exam-modal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden p-4">
        <div
            class="bg-white dark:bg-[#1a2235] p-6 md:p-8 rounded-2xl shadow-2xl w-full max-w-md ring-1 ring-slate-900/5 max-h-[90vh] overflow-y-auto">
            <h2 class="text-2xl font-black mb-6">Create New Exam</h2>
            <form id="create-exam-form" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Exam Title</label>
                    <input type="text" id="exam-title" required
                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 p-2 focus:ring-primary focus:border-primary"
                        placeholder="e.g. Mid-Term Physics">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Course Code</label>
                    <input type="text" id="course-code" required
                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 p-2 focus:ring-primary focus:border-primary"
                        placeholder="e.g. PHY-101">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Duration (Mins)</label>
                        <input type="number" id="exam-duration" required
                            class="w-full rounded-lg border-slate-200 dark:bg-slate-800 p-2 focus:ring-primary focus:border-primary"
                            value="60">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Date & Time</label>
                        <input type="datetime-local" id="exam-date" required
                            class="w-full rounded-lg border-slate-200 dark:bg-slate-800 p-2 focus:ring-primary focus:border-primary">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Passing Score (%)</label>
                    <input type="number" id="passing-marks" required min="1" max="100"
                        class="w-full rounded-lg border-slate-200 dark:bg-slate-800 p-2 focus:ring-primary focus:border-primary"
                        value="40">
                </div>
                <div class="mt-4 border-t border-slate-100 dark:border-slate-800 pt-4">
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-2">Import Questions</label>
                    <div class="flex gap-4 mb-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="use_preset" value="no" checked
                                onchange="document.getElementById('preset-config').classList.add('hidden')"
                                class="text-primary focus:ring-primary">
                            <span class="text-sm font-bold">Manual Entry</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="use_preset" value="yes"
                                onchange="document.getElementById('preset-config').classList.remove('hidden')"
                                class="text-primary focus:ring-primary">
                            <span class="text-sm font-bold">Upload File</span>
                        </label>
                    </div>

                    <div id="preset-config"
                        class="hidden bg-slate-50 dark:bg-slate-800 p-4 rounded-lg border border-slate-100 dark:border-slate-700 space-y-3">

                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-xs font-bold uppercase text-slate-500">Question Bank File</label>
                            <button type="button" onclick="downloadSampleTemplate()"
                                class="text-[10px] font-bold text-primary hover:underline flex items-center gap-1">
                                <span class="material-symbols-outlined text-[10px]">download</span> Sample Template
                            </button>
                        </div>
                        <input type="file" id="import-question-file" accept=".pdf,.docx,.doc,.txt,.json"
                            class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-primary/10 file:text-primary hover:file:bg-primary/20">
                        <p class="text-[10px] text-slate-400 mt-1">Supported: PDF, Word (.docx), Text, or JSON files.</p>
                        <div class="bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-200 dark:border-slate-700 mt-2">
                            <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Expected Format</p>
                            <pre class="text-[10px] text-slate-400 font-mono leading-relaxed whitespace-pre-wrap">Q: What is phishing?
A) Online shopping
B) Fake messages to steal data
C) Antivirus alert
D) Government notice
Answer: B</pre>
                        </div>
                        <p id="import-parse-status" class="text-xs font-bold text-slate-400 mt-2 hidden"></p>
                    </div>
                </div>

                <div class="flex gap-3 mt-6">
                    <button type="button" onclick="document.getElementById('create-exam-modal').classList.add('hidden')"
                        class="flex-1 py-3 font-bold text-slate-500 hover:bg-slate-50 rounded-lg">Cancel</button>
                    <button type="submit"
                        class="flex-1 bg-primary text-white py-3 rounded-lg font-bold shadow-lg shadow-primary/30">Create
                        Exam</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sentry Error Tracking -->
    <script src="https://js-de.sentry-cdn.com/c03a269f0eb47137cb3affe15ac7f578.min.js" crossorigin="anonymous"></script>

    <script src="script.js"></script>

    <!-- Vercel Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>
</body>

</html>